# Raspberry Pi 3 B+, Bookworm 64-bit, Python 3.11.
# Mesclar no .env existente; preservar as credenciais do MongoDB.
# Perfil medido no Pi nos tres cenarios em 26/09/2026, e a pose em 416 com uma
# pessoa em 01/10/2026; ver docs/PLANO_OTIMIZACAO.md.
CITYLAB_PROFILE=rpi3
CITYLAB_ALLOW_PARTIAL_PIPELINE=0
CITYLAB_ENABLE_FACE_SERVICE=1
CITYLAB_ENABLE_GESTURE_SERVICE=1
FACE_MINIMAL_MODULES=1
FACE_PREFILTER=1
PIPELINE_RUN_IN_PARALLEL=1
PIPELINE_MAX_WORKERS=2
# Caixa fraca alimenta o ByteTrack, mas nao sai publicada como pessoa.
# O track() do Ultralytics forca conf=0.1; a passada dupla usava 0,25.
GESTURE_PUBLISH_MIN_CONFIDENCE=0.25
# Ajustes do gate de movimento, que o perfil liga:
# GESTURE_MOTION_MIN_RATIO=0.002
# GESTURE_MOTION_PIXEL_DELTA=25
# Teto de tempo sem rodar a pose, protege quem entra em cena e fica parado.
# GESTURE_MOTION_MAX_SKIP_SECONDS=30
ENABLE_PERFORMANCE_METRICS=1
ENABLE_SYSTEM_MONITOR=1
# Herdados do perfil, podem ser sobrescritos para comparar cada ajuste:
# ONNX_INTRA_OP_THREADS=2
# TORCH_NUM_THREADS=3
# OPENCV_NUM_THREADS=1
# NATIVE_NUM_THREADS=1
# MAX_IN_FLIGHT_FRAMES=1
# PIPELINE_SHARED_PERSON_POSE=1
# GESTURE_MOTION_GATE=1
# POSE_IMGSZ=416
# FACE_REUSE_SECONDS=15
# FACE_EMBED_FULL_FRAME=1
# NCNN_NUM_THREADS=2
# Valores 0 nas tres opcoes de threads preservam o automatico da biblioteca.
# PIPELINE_SHARED_PERSON_POSE=0 volta ao detector separado de pessoas,
# GESTURE_MOTION_GATE=0 roda a pose em todo frame, POSE_IMGSZ=0 volta a pose
# aos 640 do Ultralytics, FACE_REUSE_SECONDS=0 reconhece todo rosto em todo
# frame, sem herdar o nome do frame anterior, e FACE_EMBED_FULL_FRAME=0 gera o
# embedding na imagem reduzida pela PROCESS_SCALE.
# Medido no Pi em 01/10/2026 sem efeito: 0 faz as threads do ONNX Runtime
# dormirem entre operadores em vez de girar a espera.
# ONNX_ALLOW_SPINNING=0
# Aprendizado pelo stream, padrao do sistema desde 05/10/2026: o rosto
# reconhecido com folga vira referencia da pessoa, guardada no MongoDB
# (rostos_aprendidos). Ate 5 por pessoa, uma a cada 10 min, apagadas depois de
# 30 dias; cheias, a nova troca a menos parecida com o cadastro, e a quase igual
# a uma guardada so disputa a vaga dela. Guarda dado biometrico (LGPD).
# FACE_LEARN_FROM_STREAM=0 desliga; tools/limpar_aprendidos.py mostra e apaga.
FACE_LEARN_FROM_STREAM=1
# FACE_LEARNED_PER_PERSON=5
# FACE_LEARN_INTERVAL_SECONDS=600
# FACE_LEARNED_RETENTION_DAYS=30
# Pose em NCNN, ligada no Pi desde 04/10/2026: frame com uma pessoa 40% mais
# rapido que com o .pt. A pasta exportada em 320x416 vai a mao, fora do Git, e o
# pacote ncnn entra com --no-deps; ver docs/RASPBERRY_PI.md, "Backend NCNN
# opcional". O perfil roda o ncnn em 2 threads; NCNN_NUM_THREADS=0 volta as 4
# do padrao. A serie de 4 com subtensao foi invalidada: a causa era a tomada.
# POSE_MODEL_PATH=App/GestureRecon/yolov8n-pose_ncnn_model
# Detector de rosto det_500m do buffalo_sc, ligado no Pi desde 04/10/2026:
# frame com uma pessoa 22% mais rapido que so com o NCNN, mesmo reconhecimento.
# Copiado a mao; o reconhecedor e o cadastro ficam. Ver docs/RASPBERRY_PI.md,
# FACE_DETECTOR_PATH.
# FACE_DETECTOR_PATH=~/.insightface/models/det_500m.onnx
# Reconhecimento do rosto em segundo plano (P5): o frame volta quando o gesto
# termina, e o embedding roda numa thread; ate o nome sair, o rosto aparece
# como "verificando", sem evento. Reprovado no Pi em 05/10/2026, com o nome
# confirmado em 2 de 30 frames; regra nova de confirmacao em 06/10/2026, medida
# no PC, falta o Pi. Ver docs/PLANO_OTIMIZACAO.md, P5.
# FACE_ASYNC_RECOGNITION=1
# Dias que os eventos ficam no banco; o MongoDB apaga os mais velhos, e os ja
# vencidos saem de uma vez quando o prazo e ligado. 0 guarda tudo. Padrao: 30.
# EVENT_RETENTION_DAYS=30
# Iniciar com python tools/run_rpi.py para aplicar limites BLAS/OpenMP antes dos imports.
