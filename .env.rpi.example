# Raspberry Pi 3 B+, Bookworm 64-bit, Python 3.11.
# Mesclar no .env existente; preservar as credenciais do MongoDB.
# Perfil experimental: comparar uma alteracao por vez antes de promover.
CITYLAB_PROFILE=rpi3
CITYLAB_ALLOW_PARTIAL_PIPELINE=0
CITYLAB_ENABLE_FACE_SERVICE=1
CITYLAB_ENABLE_GESTURE_SERVICE=1
FACE_MINIMAL_MODULES=1
FACE_PREFILTER=1
PIPELINE_RUN_IN_PARALLEL=1
PIPELINE_MAX_WORKERS=2
# Mantem o detector original ate validar as caixas da pose no Pi.
PIPELINE_SHARED_PERSON_POSE=0
ENABLE_PERFORMANCE_METRICS=1
ENABLE_SYSTEM_MONITOR=1
# Herdados do perfil, podem ser sobrescritos para comparar cada ajuste:
# ONNX_INTRA_OP_THREADS=1
# TORCH_NUM_THREADS=2
# OPENCV_NUM_THREADS=1
# NATIVE_NUM_THREADS=1
# MAX_IN_FLIGHT_FRAMES=1
# Valores 0 nas tres opcoes de threads preservam o automatico da biblioteca.
# Iniciar com python tools/run_rpi.py para aplicar limites BLAS/OpenMP antes dos imports.
