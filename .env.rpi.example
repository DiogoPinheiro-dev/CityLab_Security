MONGO_DETAILS=mongodb://localhost:27017
MONGO_DB_NAME=recon-db
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_FORCE_IPV4=0

# Permite que a API suba mesmo se Face/YOLO/torch/InsightFace ainda nao estiverem
# instalados ou funcionando no Raspberry Pi.
CITYLAB_ALLOW_PARTIAL_PIPELINE=1

# Ligue estes servicos depois de validar as dependencias pesadas no Pi.
CITYLAB_ENABLE_FACE_SERVICE=0
CITYLAB_ENABLE_GESTURE_SERVICE=0
